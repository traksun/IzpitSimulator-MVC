@model List<ExamAttempt>
@{ ViewData["Title"] = "История"; }

<div class="card">
    <h2>История на опитите</h2>
    @if (Model.Count == 0)
    {
        <p class="mu">Още няма записани опити.</p>
    }
    else
    {
        <table>
            <thead><tr><th>Дата</th><th>Резултат</th><th>Статус</th></tr></thead>
            <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.TakenAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@a.Score / @a.Total</td>
                    <td>@(a.Passed ? "✔ Издържан" : "✘ Неиздържан")</td>
                </tr>
            }
            </tbody>
        </table>
    }
    <p><a class="btn" asp-action="Sheet">Нова листовка</a></p>
</div>
